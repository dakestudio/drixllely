# Invitación de boda Drix & Llely — variables de entorno
# Copia este archivo a .env y rellena los valores.
#
# IMPORTANTE: todo lo que empieza por VITE_ termina dentro del bundle que
# descarga el navegador. Nada de esto es secreto, y no pasa nada: la clave de
# Firebase está pensada para ser pública. Quien protege los datos son las
# reglas de Firestore (ver firestore.rules) y Firebase Auth.

VITE_SITE_URL=https://drixllely.vercel.app

# Firebase → Consola → ⚙ Configuración del proyecto → Tus apps → Configuración
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Ya NO existe VITE_ADMIN_PASSWORD: el panel usa Firebase Auth con correo y
# contraseña, gestionados desde la consola de Firebase (Authentication → Users).
