# Invitación de boda Drix & Llely — variables de entorno
# Copia este archivo a .env y rellena los valores.
# Recuerda: TODO lo que empieza por VITE_ termina dentro del bundle que
# descarga el navegador. Nada aquí es secreto.

VITE_SITE_URL=https://drixllely.vercel.app

# Firebase (Consola de Firebase > Configuración del proyecto > Tus apps)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Contraseña del panel /admin.
# ⚠️ Es solo comodidad, NO seguridad: se puede leer del JavaScript desplegado.
# Quien protege de verdad la lista de invitados son las reglas de Firestore.
VITE_ADMIN_PASSWORD=cambia-esta-contrasena
